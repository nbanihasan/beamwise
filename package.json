{
  "name": "photonova",
  "version": "0.1.0",
  "private": true,
  "description": "Photonova: an open, interactive, 3D atlas for learning optical wireless communications (VLC, LiFi, OCC, FSO, UWOC) from zero to hero.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "new:lesson": "node scripts/new-lesson.mjs"
  },
  "dependencies": {
    "@mdx-js/react": "3.1.0",
    "@react-three/drei": "9.117.3",
    "@react-three/fiber": "8.17.10",
    "@react-three/postprocessing": "2.16.3",
    "framer-motion": "11.11.17",
    "katex": "0.16.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "3.1.0",
    "@types/katex": "0.16.7",
    "@types/mdx": "2.0.13",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.3",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.0",
    "remark-math": "6.0.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.5"
  }
}
